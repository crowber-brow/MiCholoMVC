@{
    ViewData["Title"] = "Reportes";
}

<div class="container mt-4">

    <div class="mb-4">

        <h2>Reportes</h2>

        <p class="text-muted">
            Consulta información de ventas y pérdidas del minimarket Mi Cholo.
        </p>

    </div>

    <div class="row g-4">

        <div class="col-md-6">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h4>
                        Reporte de Ventas
                    </h4>

                    <p class="text-muted">
                        Consulta las ventas registradas por rango de fechas,
                        caja y categoría.
                    </p>

                    <ul>
                        <li>Total vendido.</li>
                        <li>Cantidad de ventas.</li>
                        <li>Cantidad de productos vendidos.</li>
                        <li>Método de pago.</li>
                        <li>Caja utilizada.</li>
                        <li>Categorías involucradas.</li>
                    </ul>

                    <a asp-action="Ventas"
                       class="btn btn-primary">
                        Ver reporte de ventas
                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h4>
                        Reporte de Pérdidas
                    </h4>

                    <p class="text-muted">
                        Consulta las pérdidas registradas y su impacto económico.
                    </p>

                    <ul>
                        <li>Cantidad perdida.</li>
                        <li>Motivo.</li>
                        <li>Producto.</li>
                        <li>Lote.</li>
                        <li>Justificación.</li>
                        <li>Valor económico.</li>
                    </ul>

                    <a asp-action="Perdidas"
                       class="btn btn-danger">
                        Ver reporte de pérdidas
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>