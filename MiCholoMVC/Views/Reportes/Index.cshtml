@{ViewData["Title"]="Reportes";var tipos=new Dictionary<string,string>{{"ventas","Ventas y utilidad bruta"},{"perdidas","Pérdidas"},{"inventario","Inventario"},{"stock","Stock mínimo"},{"vencimientos","Vencimientos"},{"caja","Movimientos de caja"}};}
<h2>Reportes del minimarket</h2><p class="text-muted">Consulte por período y descargue el resultado en PDF.</p><div class="row g-3">@foreach(var t in tipos){<div class="col-md-4"><a asp-action="Informes" asp-route-tipo="@t.Key" class="card p-4 text-decoration-none"><h4>@t.Value</h4><span>Consultar y exportar PDF →</span></a></div>}</div>
