@model MiCholoMVC.ViewModels.InformeViewModel
@{ViewData["Title"]=Model.Titulo;var tipos=new Dictionary<string,string>{{"ventas","Ventas"},{"perdidas","Pérdidas"},{"inventario","Inventario"},{"stock","Stock mínimo"},{"vencimientos","Vencimientos"},{"caja","Movimientos de caja"}};}
<h2>@Model.Titulo</h2><div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Informes" method="get" class="card p-3 mb-4"><div class="row g-3">
<div class="col-md-3"><label asp-for="Tipo">Reporte</label><select asp-for="Tipo" class="form-select" onchange="this.form.submit()">@foreach(var t in tipos){<option value="@t.Key">@t.Value</option>}</select></div>
<div class="col-md-3"><label asp-for="Desde">Desde @(Model.Tipo=="vencimientos"?"(vencimiento)":Model.Tipo=="inventario"||Model.Tipo=="stock"?"(ingreso del lote)":"")</label><input asp-for="Desde" type="date" class="form-control"/></div><div class="col-md-3"><label asp-for="Hasta">Hasta</label><input asp-for="Hasta" type="date" class="form-control"/></div>
@if(Model.Tipo!="caja") {<div class="col-md-3"><label asp-for="IdProducto">Producto</label><select asp-for="IdProducto" asp-items="Model.Productos" class="form-select"><option value="">Todos</option></select></div>}
@if(Model.Tipo=="ventas"){<div class="col-md-3"><label asp-for="IdCategoria">Categoría</label><select asp-for="IdCategoria" asp-items="Model.Categorias" class="form-select"><option value="">Todas</option></select></div><div class="col-md-3 align-self-end"><label><input asp-for="IncluirAnuladas"/> Mostrar anuladas</label></div>}
@if(Model.Tipo=="ventas"||Model.Tipo=="caja"){<div class="col-md-3"><label asp-for="IdCaja">Caja</label><select asp-for="IdCaja" asp-items="Model.Cajas" class="form-select"><option value="">Todas</option></select></div>}
@if(Model.Tipo=="perdidas"){<div class="col-md-3"><label asp-for="Motivo">Motivo</label><select asp-for="Motivo" class="form-select"><option value="">Todos</option>@foreach(var motivo in MiCholoMVC.Services.ReglasNegocio.MotivosPerdida){<option>@motivo</option>}</select></div>}
@if(Model.Tipo=="vencimientos"){<div class="col-md-3"><label asp-for="Grupo">Estado</label><select asp-for="Grupo" class="form-select"><option value="">Todos</option><option value="VENCIDO">Vencidos</option><option value="HOY">Vencen hoy</option><option value="7">1 a 7 días</option><option value="15">8 a 15 días</option><option value="30">16 a 30 días</option><option value="VIGENTE">Más de 30 días</option></select></div>}
</div><div class="d-flex gap-2 mt-3"><button class="btn btn-primary">Consultar</button><button class="btn btn-outline-danger" name="pdf" value="true">Exportar PDF</button><a asp-action="Informes" asp-route-tipo="@Model.Tipo" class="btn btn-outline-secondary">Limpiar filtros</a></div></form>
<p>@Model.Periodo</p><div class="alert alert-info">@foreach(var total in Model.Totales){<div>@total</div>}</div>
<div class="card p-3 table-responsive"><table class="table table-striped"><thead><tr>@foreach(var c in Model.Columnas){<th>@c</th>}</tr></thead><tbody>@foreach(var fila in Model.Filas){<tr>@foreach(var valor in fila){<td>@valor</td>}</tr>}</tbody></table>@if(Model.Filas.Count==0){<p>No hay registros para estos filtros.</p>}</div>
