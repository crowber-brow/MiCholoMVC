@model MiCholoMVC.ViewModels.ReporteVentasViewModel

@{
    ViewData["Title"] = "Reporte de Ventas";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>Reporte de Ventas</h2>

            <p class="text-muted">
                Consulta de ventas por fecha, caja y categoría.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-secondary">
            Volver
        </a>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <strong>
                Filtros de búsqueda
            </strong>

        </div>

        <div class="card-body">

            <form asp-action="Ventas"
                  method="get">

                <div class="row g-3">

                    <div class="col-md-3">

                        <label asp-for="FechaDesde"
                               class="form-label">
                            Fecha desde
                        </label>

                        <input asp-for="FechaDesde"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-3">

                        <label asp-for="FechaHasta"
                               class="form-label">
                            Fecha hasta
                        </label>

                        <input asp-for="FechaHasta"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-3">

                        <label asp-for="IdCaja"
                               class="form-label">
                            Caja
                        </label>

                        <select asp-for="IdCaja"
                                class="form-select">

                            <option value="">
                                Todas las cajas
                            </option>

                            @foreach (var caja in Model.Cajas)
                            {
                                <option value="@caja.IdCaja">
                                    @caja.Nombre
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-3">

                        <label asp-for="IdCategoria"
                               class="form-label">
                            Categoría
                        </label>

                        <select asp-for="IdCategoria"
                                class="form-select">

                            <option value="">
                                Todas las categorías
                            </option>

                            @foreach (var categoria in Model.Categorias)
                            {
                                <option value="@categoria.IdCategoria">
                                    @categoria.Nombre
                                </option>
                            }

                        </select>

                    </div>

                </div>

                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Buscar
                    </button>

                    <a asp-action="Ventas"
                       class="btn btn-secondary">
                        Limpiar filtros
                    </a>

                </div>

            </form>

        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total vendido
                    </h6>

                    <h3>
                        S/ @Model.TotalVentas.ToString("F2")
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Cantidad de ventas
                    </h6>

                    <h3>
                        @Model.CantidadVentas
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Productos vendidos
                    </h6>

                    <h3>
                        @Model.CantidadProductosVendidos
                    </h3>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">

            <strong>
                Detalle de ventas
            </strong>

        </div>

        <div class="card-body">

            @if (!Model.Ventas.Any())
            {
                <div class="alert alert-info">
                    No existen ventas para los filtros seleccionados.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-dark">

                            <tr>

                                <th>
                                    N° Venta
                                </th>

                                <th>
                                    Fecha
                                </th>

                                <th>
                                    Caja
                                </th>

                                <th>
                                    Método de pago
                                </th>

                                <th>
                                    Categorías
                                </th>

                                <th>
                                    Productos
                                </th>

                                <th>
                                    Total
                                </th>

                                <th>
                                    Acción
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var venta in Model.Ventas)
                            {
                                <tr>

                                    <td>
                                        @venta.IdVenta
                                    </td>

                                    <td>
                                        @venta.Fecha.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @venta.Caja
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @venta.MetodoPago
                                        </span>
                                    </td>

                                    <td>
                                        @venta.Categorias
                                    </td>

                                    <td>
                                        @venta.CantidadProductos
                                    </td>

                                    <td>
                                        <strong>
                                            S/ @venta.Total.ToString("F2")
                                        </strong>
                                    </td>

                                    <td>

                                        <a asp-controller="Ventas"
                                           asp-action="Detalle"
                                           asp-route-id="@venta.IdVenta"
                                           class="btn btn-sm btn-info text-white">
                                            Ver
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>