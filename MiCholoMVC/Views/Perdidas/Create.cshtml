@model MiCholoMVC.ViewModels.PerdidaCreateViewModel
@{ViewData["Title"]="Registrar pérdida";}
<h2>Registrar pérdida</h2><div class="card p-4"><div asp-validation-summary="All" class="text-danger"></div><div id="errorLotes" class="text-danger" role="alert"></div>
<form asp-action="Create" method="post" id="perdidaForm"><div class="row g-3">
<div class="col-md-6"><label asp-for="IdProducto">Producto</label><select asp-for="IdProducto" asp-items="ViewBag.Productos" class="form-select"><option value="">Seleccione...</option></select></div>
<div class="col-md-6"><label asp-for="IdLote">Lote</label><select asp-for="IdLote" asp-items="ViewBag.Lotes" class="form-select"><option value="">Seleccione...</option></select></div>
<div class="col-md-4"><label asp-for="Cantidad">Cantidad perdida</label><input asp-for="Cantidad" type="number" min="1" required class="form-control"/></div>
<div class="col-md-4"><label>Costo unitario</label><output id="costo" class="form-control">S/ 0.00</output></div><div class="col-md-4"><label>Valor total perdido</label><output id="valor" class="form-control">S/ 0.00</output></div>
<div class="col-md-6"><label asp-for="Motivo">Motivo</label><select asp-for="Motivo" class="form-select"><option value="">Seleccione...</option>@foreach(var motivo in MiCholoMVC.Services.ReglasNegocio.MotivosPerdida){<option>@motivo</option>}</select></div>
<div class="col-md-12"><label asp-for="Justificacion">Justificación</label><textarea asp-for="Justificacion" maxlength="500" required class="form-control"></textarea></div></div><p class="text-muted mt-3">El costo se conserva al registrar la pérdida. La operación descuenta stock y genera un movimiento de Kardex.</p><button class="btn btn-danger">Registrar pérdida</button><a asp-action="Index" class="btn btn-secondary">Volver</a></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>
let lotes=[];const producto=document.getElementById('IdProducto'),lote=document.getElementById('IdLote'),cantidad=document.getElementById('Cantidad');
function calcular(){const l=lotes.find(x=>String(x.id)===lote.value);document.getElementById('costo').textContent='S/ '+Number(l?.costo||0).toFixed(2);document.getElementById('valor').textContent='S/ '+((l?.costo||0)*Number(cantidad.value||0)).toFixed(2);cantidad.max=l?.cantidad||0;}
async function cargar(){const elegido=lote.value;lote.replaceChildren(new Option('Seleccione...',''));lotes=[];if(!producto.value){calcular();return;}try{const r=await fetch('/Perdidas/ObtenerLotesPorProducto?idProducto='+encodeURIComponent(producto.value));if(!r.ok||!r.headers.get('content-type')?.includes('application/json'))throw new Error();lotes=await r.json();for(const l of lotes){lote.add(new Option(l.numero+' · Stock: '+l.cantidad,l.id));}lote.value=elegido;document.getElementById('errorLotes').textContent='';}catch{document.getElementById('errorLotes').textContent='No se pudieron consultar los lotes. Intente nuevamente.';}calcular();}
producto.addEventListener('change',cargar);lote.addEventListener('change',calcular);cantidad.addEventListener('input',calcular);cargar();
</script>}
