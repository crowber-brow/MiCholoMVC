@model IEnumerable<MiCholoMVC.Models.Perdida>

@{
    ViewData["Title"] = "Pérdidas";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Registro de Pérdidas</h2>

        <a asp-action="Create"
           class="btn btn-primary">
            + Registrar pérdida
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover">

                    <thead>

                        <tr>
                            <th>ID</th>
                            <th>Producto</th>
                            <th>Lote</th>
                            <th>Cantidad</th>
                            <th>Motivo</th>
                            <th>Justificación</th>
                            <th>Fecha</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.IdPerdida
                                </td>

                                <td>
                                    @item.Lote?.Producto?.Nombre
                                </td>

                                <td>
                                    @item.Lote?.NumeroLote
                                </td>

                                <td>
                                    @item.Cantidad
                                </td>

                                <td>

                                    @switch (item.Motivo)
                                    {
                                        case "ROBO":
                                            <span class="badge bg-danger">
                                                ROBO
                                            </span>
                                            break;

                                        case "ROTURA":
                                            <span class="badge bg-warning text-dark">
                                                ROTURA
                                            </span>
                                            break;

                                        case "EXTRAVIO":
                                            <span class="badge bg-secondary">
                                                EXTRAVÍO
                                            </span>
                                            break;

                                        case "DETERIORO":
                                            <span class="badge bg-warning text-dark">
                                                DETERIORO
                                            </span>
                                            break;

                                        case "MERMA":
                                            <span class="badge bg-info text-dark">
                                                MERMA
                                            </span>
                                            break;

                                        default:
                                            <span class="badge bg-secondary">
                                                @item.Motivo
                                            </span>
                                            break;
                                    }

                                </td>

                                <td>
                                    @item.Justificacion
                                </td>

                                <td>
                                    @item.Fecha.ToString(
                                        "dd/MM/yyyy HH:mm")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>  