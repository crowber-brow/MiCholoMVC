@model IEnumerable<MiCholoMVC.ViewModels.VencimientoViewModel>
@{ViewData["Title"]="Vencimientos";var grupos=new Dictionary<string,string>{{"VENCIDO","Vencidos"},{"HOY","Vencen hoy"},{"7","1 a 7 días"},{"15","8 a 15 días"},{"30","16 a 30 días"},{"VIGENTE","Más de 30 días"}};}
<h2>Control de vencimientos</h2><p class="text-muted">Solo lotes activos con unidades. La fecha de vencimiento es el último día de vigencia.</p>
<form class="row g-2 mb-3"><div class="col-md-4"><label>Estado</label><select name="grupo" class="form-select"><option value="">Todos</option>@foreach(var g in grupos){<option value="@g.Key" selected="@(ViewBag.Grupo==g.Key)">@g.Value</option>}</select></div><div class="col-md-3"><label>Vencimiento desde</label><input type="date" name="desde" value="@(((DateTime?)ViewBag.Desde)?.ToString("yyyy-MM-dd"))" class="form-control"/></div><div class="col-md-3"><label>Hasta</label><input type="date" name="hasta" value="@(((DateTime?)ViewBag.Hasta)?.ToString("yyyy-MM-dd"))" class="form-control"/></div><div class="col-md-2 align-self-end"><button class="btn btn-primary">Filtrar</button></div></form>
<div class="alert alert-info">@Model.Count() lotes · @Model.Sum(v=>v.Cantidad) unidades · Valor al costo: <strong>S/ @Model.Sum(v=>v.ValorTotal).ToString("F2")</strong></div>
<div class="card p-3 table-responsive"><table class="table"><thead><tr><th>Producto</th><th>Lote</th><th>Unidades</th><th>Vencimiento</th><th>Días restantes</th><th>Estado</th><th>Valor al costo</th></tr></thead><tbody>@foreach(var v in Model){<tr><td>@v.Producto</td><td>@v.NumeroLote</td><td>@v.Cantidad</td><td>@v.FechaVencimiento.ToString("dd/MM/yyyy")</td><td>@v.DiasRestantes</td><td><span class="badge bg-@v.Color @(v.Color=="warning"?"text-dark":"")">@v.EstadoVencimiento</span></td><td>S/ @v.ValorTotal.ToString("F2")</td></tr>}</tbody></table>@if(!Model.Any()){<p>No hay lotes para estos filtros.</p>}</div>
<a asp-controller="Reportes" asp-action="Informes" asp-route-tipo="vencimientos" class="btn btn-outline-primary mt-3">Reporte y PDF de vencimientos</a>
