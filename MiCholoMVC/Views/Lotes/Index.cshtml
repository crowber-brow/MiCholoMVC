@model IEnumerable<MiCholoMVC.Models.Lote>

@{
    ViewData["Title"] = "Lotes";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Lotes</h2>

        <a asp-action="Create"
           class="btn btn-primary">

            + Nuevo lote

        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover">

                    <thead>

                        <tr>
                            <th>ID</th>
                            <th>Producto</th>
                            <th>N.º Lote</th>
                            <th>Cantidad</th>
                            <th>Fecha ingreso</th>
                            <th>Fecha vencimiento</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            var dias = (item.FechaVencimiento.Date -
                                        DateTime.Today).Days;

                            <tr>

                                <td>
                                    @item.IdLote
                                </td>

                                <td>
                                    @item.Producto?.Nombre
                                </td>

                                <td>
                                    @item.NumeroLote
                                </td>

                                <td>
                                    @item.Cantidad
                                </td>

                                <td>
                                    @item.FechaIngreso.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @item.FechaVencimiento.ToString("dd/MM/yyyy")
                                </td>

                                <td>

                                    @if (!item.Estado)
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }
                                    else if (dias <= 0)
                                    {
                                        <span class="badge bg-dark">
                                            Vencido
                                        </span>
                                    }
                                    else if (dias <= 7)
                                    {
                                        <span class="badge bg-danger">
                                            Rojo
                                        </span>
                                    }
                                    else if (dias <= 30)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Amarillo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Verde
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.IdLote"
                                       class="btn btn-sm btn-warning">

                                        Editar

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>