@model List<MiCholoMVC.Models.MovimientoCaja>

@{
    ViewData["Title"] = "Movimientos de Caja";
    var caja = ViewBag.Caja as MiCholoMVC.Models.Caja;

    decimal saldo = caja?.MontoInicial ?? 0;

    foreach (var movimiento in Model)
    {
        if (movimiento.Tipo == "INGRESO")
        {
            saldo += movimiento.Monto;
        }
        else if (movimiento.Tipo == "EGRESO")
        {
            saldo -= movimiento.Monto;
        }
    }
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Movimientos de Caja</h2>

            @if (caja != null)
            {
                <p class="text-muted mb-0">
                    @caja.Nombre
                </p>
            }
        </div>

        @if (caja != null && caja.Estado == "ABIERTA")
        {
            <a asp-action="Movimiento"
               asp-route-id="@caja.IdCaja"
               class="btn btn-primary">
                + Nuevo movimiento
            </a>
        }
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Saldo actual</h5>

            <h2>
                S/ @saldo.ToString("F2")
            </h2>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Esta caja todavía no tiene movimientos registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Tipo</th>
                        <th>Monto</th>
                        <th>Descripción</th>
                        <th>Fecha</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var movimiento in Model)
                    {
                        <tr>
                            <td>
                                @movimiento.IdMovimiento
                            </td>

                            <td>
                                @if (movimiento.Tipo == "INGRESO")
                                {
                                    <span class="badge bg-success">
                                        INGRESO
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        EGRESO
                                    </span>
                                }
                            </td>

                            <td>
                                S/ @movimiento.Monto.ToString("F2")
                            </td>

                            <td>
                                @movimiento.Descripcion
                            </td>

                            <td>
                                @movimiento.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <div class="mt-3">
        <a asp-action="Index"
           class="btn btn-secondary">
            Volver a cajas
        </a>
    </div>

</div>