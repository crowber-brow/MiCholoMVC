@model MiCholoMVC.ViewModels.CajaAbrirViewModel

@{
    ViewData["Title"] = "Abrir Caja";
}

<div class="container mt-4">

    <h2>Abrir Caja</h2>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Abrir"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="Nombre"
                           class="form-label">
                        Nombre de la caja
                    </label>

                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Ejemplo: Caja Principal" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="MontoInicial"
                           class="form-label">
                        Monto inicial
                    </label>

                    <input asp-for="MontoInicial"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="MontoInicial"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-success">
                    Abrir caja
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}   