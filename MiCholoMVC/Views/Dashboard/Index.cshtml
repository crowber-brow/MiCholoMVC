@model MiCholoMVC.ViewModels.DashboardViewModel
@using MiCholoMVC.ViewModels
@{ViewData["Title"]="Dashboard gerencial";var tarjetas=new[]{("Ventas hoy",$"S/ {Model.VentasHoy:F2}"),("Ventas del mes",$"S/ {Model.VentasMes:F2}"),("Stock bajo",Model.ProductosStockBajo.ToString()),("Lotes próximos a vencer",Model.LotesPorVencer.ToString()),("Pérdidas del mes",$"S/ {Model.PerdidasMes:F2}"),("Efectivo en caja abierta",$"S/ {Model.CajaActual:F2}"),("Utilidad bruta del mes",$"S/ {Model.UtilidadBrutaMes:F2}"),("Valor próximo a vencer",$"S/ {Model.ValorPorVencer:F2}")};}
<div class="d-flex justify-content-between mb-3"><div><h2>Mi Cholo · Dashboard</h2><p class="text-muted">Información del negocio · @MiCholoMVC.Services.ReglasNegocio.Ahora.ToString("dd/MM/yyyy HH:mm")</p></div><a asp-controller="Ventas" asp-action="Crear" class="btn btn-success align-self-start">Nueva venta</a></div>
@if(Model.LotesVencidos>0){<a asp-controller="Vencimientos" asp-action="Index" asp-route-grupo="VENCIDO" class="alert alert-danger d-block text-decoration-none">Hay @Model.LotesVencidos lotes vencidos con stock. Revise y registre su retiro o pérdida.</a>}
<div class="row g-3 mb-4">@foreach(var t in tarjetas){<div class="col-sm-6 col-xl-3"><div class="card p-3 h-100"><span class="text-muted">@t.Item1</span><strong class="fs-3">@t.Item2</strong></div></div>}</div>
<p class="text-muted">La utilidad bruta descuenta el costo de los productos vendidos; no incluye gastos del negocio. Las ventas anuladas se excluyen.</p>
<div class="row g-4">
<div class="col-lg-6"><div class="card p-3"><h4>Ventas por día · últimos 7 días</h4><partial name="_Barras" model="@(Model.VentasUltimos7Dias.Select(v=>new SerieDashboard{Nombre=v.Fecha.ToString("dd/MM"),Valor=v.Total}).ToList())"/></div></div>
<div class="col-lg-6"><div class="card p-3"><h4>Ventas por mes · últimos 6 meses</h4><partial name="_Barras" model="Model.VentasPorMes"/></div></div>
<div class="col-lg-6"><div class="card p-3"><h4>Productos más vendidos · mes actual (unidades)</h4><partial name="_Barras" model="Model.ProductosMasVendidos"/></div></div>
<div class="col-lg-6"><div class="card p-3"><h4>Pérdidas por motivo · mes actual (S/)</h4><partial name="_Barras" model="Model.PerdidasPorMotivo"/></div></div>
<div class="col-lg-6"><div class="card p-3"><h4>Vencimientos · valor al costo (S/)</h4><partial name="_Barras" model="Model.VencimientosPorGrupo"/></div></div>
<div class="col-lg-6"><div class="card p-3"><h4>Pagos · mes actual</h4><table class="table"><thead><tr><th>Método</th><th>Ventas</th><th>Total</th></tr></thead><tbody>@foreach(var r in Model.VentasPorMetodoPago){<tr><td>@r.MetodoPago</td><td>@r.Cantidad</td><td>S/ @r.Total.ToString("F2")</td></tr>}</tbody></table><p>Total histórico vigente: S/ @Model.VentasTotales.ToString("F2") · Pérdidas históricas: S/ @Model.TotalPerdidas.ToString("F2")</p></div></div>
</div>
