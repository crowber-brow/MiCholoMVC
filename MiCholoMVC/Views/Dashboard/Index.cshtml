@model MiCholoMVC.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">

    <div class="mb-4">
        <h2>Dashboard</h2>

        <p class="text-muted">
            Resumen general del minimarket Mi Cholo.
        </p>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-4 col-lg-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Ventas de hoy
                    </h6>

                    <h3>
                        S/ @Model.VentasHoy.ToString("F2")
                    </h3>

                    <p class="mb-0 text-muted">
                        @Model.CantidadVentas venta(s) registradas
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4 col-lg-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Ventas acumuladas
                    </h6>

                    <h3>
                        S/ @Model.VentasTotales.ToString("F2")
                    </h3>

                    <p class="mb-0 text-muted">
                        Total registrado
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4 col-lg-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Stock bajo
                    </h6>

                    <h3>
                        @Model.ProductosStockBajo
                    </h3>

                    @if (Model.ProductosStockBajo > 0)
                    {
                        <span class="badge bg-danger">
                            Requiere atención
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Stock normal
                        </span>
                    }

                </div>

            </div>

        </div>

        <div class="col-md-4 col-lg-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Próximos a vencer
                    </h6>

                    <h3>
                        @Model.LotesPorVencer
                    </h3>

                    <span class="badge bg-warning text-dark">
                        Próximos 30 días
                    </span>

                </div>

            </div>

        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-6">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Lotes vencidos
                    </h6>

                    <h3>
                        @Model.LotesVencidos
                    </h3>

                    @if (Model.LotesVencidos > 0)
                    {
                        <span class="badge bg-danger">
                            Revisar inventario
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Sin lotes vencidos
                        </span>
                    }

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Pérdidas económicas
                    </h6>

                    <h3>
                        S/ @Model.TotalPerdidas.ToString("F2")
                    </h3>

                    <p class="mb-0 text-muted">
                        @Model.CantidadPerdidas pérdida(s) registrada(s)
                    </p>

                </div>

            </div>

        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-header">

                    <strong>
                        Ventas de los últimos 7 días
                    </strong>

                </div>

                <div class="card-body">

                    <canvas id="graficoVentas"></canvas>

                </div>

            </div>

        </div>

        <div class="col-lg-5">

            <div class="card shadow-sm">

                <div class="card-header">

                    <strong>
                        Ventas por método de pago
                    </strong>

                </div>

                <div class="card-body">

                    <canvas id="graficoMetodos"></canvas>

                </div>

            </div>

        </div>

    </div>

    <div class="row mt-4">

        <div class="col-12">

            <div class="card shadow-sm">

                <div class="card-header">

                    <strong>
                        Resumen de ventas por día
                    </strong>

                </div>

                <div class="card-body">

                    <div class="table-responsive">

                        <table class="table table-bordered table-hover">

                            <thead class="table-dark">

                                <tr>

                                    <th>
                                        Fecha
                                    </th>

                                    <th>
                                        Cantidad de ventas
                                    </th>

                                    <th>
                                        Total vendido
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var venta in Model.VentasUltimos7Dias)
                                {
                                    <tr>

                                        <td>
                                            @venta.Fecha.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            @venta.Cantidad
                                        </td>

                                        <td>
                                            <strong>
                                                S/ @venta.Total.ToString("F2")
                                            </strong>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const fechas = [
                    @foreach (var venta in Model.VentasUltimos7Dias)
            {
                <text>
                        "@venta.Fecha.ToString("dd/MM")",
                </text>
                    }
                ];

        const totalesVentas = [
                    @foreach (var venta in Model.VentasUltimos7Dias)
            {
                <text>
                                @venta.Total.ToString(
                System.Globalization.CultureInfo.InvariantCulture
                ),
                </text>
                    }
                ];

        const metodos = [
                    @foreach (var metodo in Model.VentasPorMetodoPago)
            {
                <text>
                        "@Html.Raw(metodo.MetodoPago.Replace("\"", "\\\""))",
                </text>
                    }
                ];

        const totalesMetodos = [
                    @foreach (var metodo in Model.VentasPorMetodoPago)
            {
                <text>
                                @metodo.Total.ToString(
                System.Globalization.CultureInfo.InvariantCulture
                ),
                </text>
                    }
                ];

        const ctxVentas =
            document.getElementById("graficoVentas");

        new Chart(ctxVentas, {
            type: "line",
            data: {
                labels: fechas,
                datasets: [{
                    label: "Ventas en S/",
                    data: totalesVentas,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        display: true
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        const ctxMetodos =
            document.getElementById("graficoMetodos");

        new Chart(ctxMetodos, {
            type: "doughnut",
            data: {
                labels: metodos,
                datasets: [{
                    label: "Ventas",
                    data: totalesMetodos
                }]
            },
            options: {
                responsive: true
            }
        });

    </script>
}