@{ ViewData["Title"] = "Cambiar contraseña"; }
<div class="card p-4 mx-auto" style="max-width:520px"><h2>Cambiar contraseña</h2><div asp-validation-summary="All" class="text-danger"></div><form method="post"><label class="form-label">Contraseña actual</label><input type="password" name="actual" required autocomplete="current-password" class="form-control mb-3"/><label class="form-label">Nueva contraseña</label><input type="password" name="nueva" required minlength="10" maxlength="128" autocomplete="new-password" class="form-control mb-3"/><label class="form-label">Confirmar nueva contraseña</label><input type="password" name="confirmar" required minlength="10" maxlength="128" autocomplete="new-password" class="form-control mb-3"/><p>Use al menos 10 caracteres, con letras y números.</p><button class="btn btn-primary">Guardar y volver al login</button></form></div>
