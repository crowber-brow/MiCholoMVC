<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Mi Cholo</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>

    <div class="d-flex min-vh-100">

        <aside class="sidebar bg-dark text-white">

            <div class="sidebar-header">
                <div class="logo-container">
                    <i class="bi bi-shop"></i>
                </div>

                <div>
                    <h4 class="mb-0">Mi Cholo</h4>
                    <small>Sistema de gestión</small>
                </div>
            </div>

            <hr class="border-secondary" />

            <nav class="nav flex-column">

                <a aria-label="Inicio" title="Inicio" class="nav-link text-white"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-house-door-fill"></i>
                    <span>Inicio</span>

                </a>

                <a aria-label="Dashboard" title="Dashboard" class="nav-link text-white"
                   asp-controller="Dashboard"
                   asp-action="Index">

                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>

                </a>

                <div class="menu-section">
                    INVENTARIO
                </div>

                <a aria-label="Categorías" title="Categorías" class="nav-link text-white"
                   asp-controller="Categorias"
                   asp-action="Index">

                    <i class="bi bi-tags-fill"></i>
                    <span>Categorías</span>

                </a>

                <a aria-label="Proveedores" title="Proveedores" class="nav-link text-white"
                   asp-controller="Proveedores"
                   asp-action="Index">

                    <i class="bi bi-truck"></i>
                    <span>Proveedores</span>

                </a>

                <a aria-label="Productos" title="Productos" class="nav-link text-white"
                   asp-controller="Productos"
                   asp-action="Index">

                    <i class="bi bi-box-seam-fill"></i>
                    <span>Productos</span>

                </a>

                <a aria-label="Lotes" title="Lotes" class="nav-link text-white"
                   asp-controller="Lotes"
                   asp-action="Index">

                    <i class="bi bi-boxes"></i>
                    <span>Lotes</span>

                </a>

                <a aria-label="Kardex e inventario" title="Kardex e inventario" class="nav-link text-white"
                   asp-controller="Inventario"
                   asp-action="Index">

                    <i class="bi bi-arrow-left-right"></i>
                    <span>Inventario</span>

                </a>

                <a aria-label="Stock mínimo" title="Stock mínimo" class="nav-link text-white"
                   asp-controller="Stock"
                   asp-action="Index">

                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>Stock mínimo</span>

                </a>

                <a aria-label="Vencimientos" title="Vencimientos" class="nav-link text-white"
                   asp-controller="Vencimientos"
                   asp-action="Index">

                    <i class="bi bi-calendar-x-fill"></i>
                    <span>Vencimientos</span>

                </a>

                <a aria-label="Pérdidas" title="Pérdidas" class="nav-link text-white"
                   asp-controller="Perdidas"
                   asp-action="Index">

                    <i class="bi bi-dash-circle-fill"></i>
                    <span>Pérdidas</span>

                </a>

                <div class="menu-section">
                    VENTAS Y CAJA
                </div>

                <a aria-label="Cajas" title="Cajas" class="nav-link text-white"
                   asp-controller="Cajas"
                   asp-action="Index">

                    <i class="bi bi-cash-stack"></i>
                    <span>Cajas</span>

                </a>

                <a aria-label="Ventas" title="Ventas" class="nav-link text-white"
                   asp-controller="Ventas"
                   asp-action="Index">

                    <i class="bi bi-cart-check-fill"></i>
                    <span>Ventas</span>

                </a>

                <div class="menu-section">
                    REPORTES
                </div>

                <a aria-label="Reportes" title="Reportes" class="nav-link text-white"
                   asp-controller="Reportes"
                   asp-action="Index">

                    <i class="bi bi-bar-chart-fill"></i>
                    <span>Reportes</span>

                </a>

            </nav>

        </aside>

        <div class="main-content flex-grow-1">

            <header class="topbar bg-white border-bottom">

                <div class="container-fluid">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h5 class="mb-0">
                                @ViewData["Title"]
                            </h5>

                        </div>

                        <div class="d-flex align-items-center gap-3">

                            <div class="text-muted">

                                <i class="bi bi-shop"></i>
                                Minimarket Mi Cholo

                            </div>

                            <a asp-controller="Account" asp-action="Password" class="btn btn-outline-secondary btn-sm" aria-label="Cambiar contraseña" title="Cambiar contraseña"><i class="bi bi-key"></i></a>
                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="m-0">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger btn-sm">

                                    <i class="bi bi-box-arrow-right"></i>
                                    Cerrar sesión

                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </header>

            <main class="container-fluid p-4">

                @RenderBody()

            </main>

            <footer class="border-top text-muted py-3 mt-auto">

                <div class="container-fluid text-center">

                    Sistema de Gestión - Minimarket Mi Cholo

                </div>

            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
