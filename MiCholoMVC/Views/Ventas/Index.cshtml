@model IEnumerable<MiCholoMVC.Models.Venta>

@{
    ViewData["Title"] = "Ventas";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Ventas</h2>
            <p class="text-muted">
                Registro y consulta de ventas del minimarket Mi Cholo.
            </p>
        </div>

        <a asp-action="Crear" class="btn btn-primary">
            Nueva venta
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-header">
            <strong>Listado de ventas</strong>
        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No existen ventas registradas.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>N° Venta</th>
                                <th>Fecha</th>
                                <th>Caja</th>
                                <th>Método de pago</th>
                                <th>Total</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var venta in Model)
                            {
                                <tr>

                                    <td>
                                        @venta.IdVenta
                                    </td>

                                    <td>
                                        @venta.Fecha.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @(venta.Caja?.Nombre ?? "Sin caja")
                                    </td>

                                    <td>
                                        @venta.MetodoPago
                                    </td>

                                    <td>
                                        <strong>
                                            S/ @venta.Total.ToString("F2")
                                        </strong>
                                    </td>

                                    <td>
                                        <a asp-action="Detalle"
                                           asp-route-id="@venta.IdVenta"
                                           class="btn btn-sm btn-info text-white">
                                            Ver detalle
                                        </a>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>