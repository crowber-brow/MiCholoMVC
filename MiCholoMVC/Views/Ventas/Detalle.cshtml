@model MiCholoMVC.Models.Venta
@{ViewData["Title"] = "Comprobante de venta";}
<div class="no-print d-flex gap-2 mb-3"><a asp-action="Index" class="btn btn-secondary">Ventas</a><a asp-action="Crear" class="btn btn-primary">Nueva venta</a><a asp-action="Comprobante" asp-route-id="@Model.IdVenta" class="btn btn-outline-primary">Descargar PDF</a><button onclick="window.print()" class="btn btn-outline-secondary">Imprimir</button></div>
@if(TempData["Error"] != null){<div class="alert alert-danger">@TempData["Error"]</div>}
@if(TempData["Mensaje"] != null){<div class="alert alert-success">@TempData["Mensaje"]</div>}
<article class="card p-4 receipt"><h2>Minimarket Mi Cholo</h2><h4>Comprobante interno #@Model.IdVenta.ToString("D6")</h4><p>@Model.Fecha.ToString("dd/MM/yyyy HH:mm") · @Model.Estado · Caja: @Model.Caja?.Nombre</p>
<table class="table"><thead><tr><th>Producto / lote</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th></tr></thead><tbody>
@foreach(var d in Model.Detalles!){<tr><td>@d.ProductoNombre <small class="text-muted">(@d.Lote?.NumeroLote)</small></td><td>@d.Cantidad</td><td>S/ @d.PrecioUnitario.ToString("F2")</td><td>S/ @d.Subtotal.ToString("F2")</td></tr>}
</tbody></table><h3 class="text-end">Total: S/ @Model.Total.ToString("F2")</h3><p>Pago: @Model.MetodoPago</p>
@if(Model.MetodoPago == "EFECTIVO"){<p>Recibido: S/ @Model.DineroRecibido.ToString("F2") · Vuelto: S/ @Model.Vuelto.ToString("F2")</p>}
@if(Model.Estado != "VIGENTE"){<div class="alert alert-warning">Anulada el @Model.FechaAnulacion: @Model.MotivoAnulacion. Stock repuesto: @(Model.StockDevuelto ? "Sí" : "No").</div>}
<small>Comprobante de control interno.</small></article>
@if(Model.Estado == "VIGENTE"){
<details class="card p-3 mt-4 no-print"><summary>Anular / devolver venta completa</summary><form asp-action="Anular" method="post" class="mt-3" onsubmit="return confirm('¿Registrar la devolución completa de esta venta?');"><input type="hidden" name="id" value="@Model.IdVenta"/><label for="motivo">Motivo</label><textarea name="motivo" id="motivo" required maxlength="500" class="form-control mb-2"></textarea><label class="form-check"><input type="checkbox" name="reponer" value="true" class="form-check-input"/> Los productos están aptos para vender y deben volver al stock</label><p class="text-muted">Sin reposición, se registra una pérdida por devolución no apta, sin descontar stock nuevamente. Requiere una caja abierta. Los pagos digitales se reintegran por su medio original.</p><button class="btn btn-danger">Registrar devolución</button></form></details>
}
