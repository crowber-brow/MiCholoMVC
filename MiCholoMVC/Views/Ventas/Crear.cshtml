@model MiCholoMVC.ViewModels.VentaCreateViewModel
@using System.Text.Json
@{ ViewData["Title"] = "Punto de venta"; }
<h2>Punto de venta</h2>
<p class="text-muted">Busque por nombre. Los lotes se seleccionan automáticamente por fecha de vencimiento.</p>
<div asp-validation-summary="All" class="alert alert-danger"></div>
<div id="posError" class="alert alert-danger d-none" role="alert"></div>
<div class="row g-4">
 <section class="col-lg-5"><div class="card p-3"><label for="buscar" class="form-label">Buscar producto</label><input id="buscar" class="form-control" placeholder="Escriba el nombre..." autocomplete="off"/><small id="estadoStock" class="text-muted my-2" aria-live="polite"></small><div id="resultados" class="list-group pos-results"></div></div></section>
 <section class="col-lg-7"><form asp-action="Crear" method="post" id="ventaForm" class="card p-3">
 <input asp-for="TokenOperacion" type="hidden"/>
 <h4>Carrito</h4><div class="table-responsive"><table class="table"><thead><tr><th>Producto</th><th>Precio</th><th>Cantidad</th><th>Subtotal</th><th></th></tr></thead><tbody id="carrito"></tbody></table></div>
 <p id="vacio" class="text-muted">Agregue productos para comenzar.</p>
 <label asp-for="MetodoPago" class="form-label">Método de pago</label><select asp-for="MetodoPago" class="form-select mb-3"><option value="">Seleccione...</option><option>EFECTIVO</option><option>YAPE</option><option>PLIN</option><option>TARJETA</option></select>
 <div id="recibidoGrupo"><label asp-for="DineroRecibido" class="form-label">Dinero recibido (S/)</label><input asp-for="DineroRecibido" type="number" min="0" step="0.01" class="form-control"/></div>
 <div class="d-flex justify-content-between mt-3 fs-4"><strong>Total</strong><strong id="total">S/ 0.00</strong></div><p id="vuelto" class="text-end"></p>
 <button id="confirmar" class="btn btn-success btn-lg" type="submit" disabled>Confirmar venta</button><a asp-action="Index" class="btn btn-link">Volver a ventas</a>
 </form></section>
</div>
@section Scripts {
<script id="carritoInicial" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Detalles.Select(d => new { idProducto = d.IdProducto, cantidad = d.Cantidad })))</script>
<script src="~/js/pos.js" asp-append-version="true"></script>
}
