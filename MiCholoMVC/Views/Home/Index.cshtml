@{
    ViewData["Title"] = "Inicio";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold">
            Bienvenido a Mi Cholo
        </h2>

        <p class="text-muted">
            Sistema de gestión del minimarket
        </p>

    </div>


    <!-- ACCESOS PRINCIPALES -->

    <div class="row g-4">

        <!-- DASHBOARD -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">

                        <i class="bi bi-speedometer2 fs-1 me-3"></i>

                        <div>

                            <h5 class="card-title mb-1">
                                Dashboard
                            </h5>

                            <p class="text-muted mb-0">
                                Resumen general del sistema
                            </p>

                        </div>

                    </div>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-dark">

                        Ver Dashboard

                    </a>

                </div>

            </div>

        </div>


        <!-- PRODUCTOS -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">

                        <i class="bi bi-box-seam fs-1 me-3"></i>

                        <div>

                            <h5 class="card-title mb-1">
                                Productos
                            </h5>

                            <p class="text-muted mb-0">
                                Gestionar productos
                            </p>

                        </div>

                    </div>

                    <a asp-controller="Productos"
                       asp-action="Index"
                       class="btn btn-dark">

                        Ver productos

                    </a>

                </div>

            </div>

        </div>


        <!-- INVENTARIO -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">

                        <i class="bi bi-boxes fs-1 me-3"></i>

                        <div>

                            <h5 class="card-title mb-1">
                                Inventario
                            </h5>

                            <p class="text-muted mb-0">
                                Control de movimientos
                            </p>

                        </div>

                    </div>

                    <a asp-controller="Inventario"
                       asp-action="Index"
                       class="btn btn-dark">

                        Ver inventario

                    </a>

                </div>

            </div>

        </div>


        <!-- VENCIMIENTOS -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">

                        <i class="bi bi-calendar-x fs-1 me-3"></i>

                        <div>

                            <h5 class="card-title mb-1">
                                Vencimientos
                            </h5>

                            <p class="text-muted mb-0">
                                Control de fechas de vencimiento
                            </p>

                        </div>

                    </div>

                    <a asp-controller="Vencimientos"
                       asp-action="Index"
                       class="btn btn-dark">

                        Ver vencimientos

                    </a>

                </div>

            </div>

        </div>


        <!-- PÉRDIDAS -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">

                        <i class="bi bi-dash-circle fs-1 me-3"></i>

                        <div>

                            <h5 class="card-title mb-1">
                                Pérdidas
                            </h5>

                            <p class="text-muted mb-0">
                                Registrar y consultar pérdidas
                            </p>

                        </div>

                    </div>

                    <a asp-controller="Perdidas"
                       asp-action="Index"
                       class="btn btn-dark">

                        Ver pérdidas

                    </a>

                </div>

            </div>

        </div>


        <!-- VENTAS -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">

                        <i class="bi bi-cart-check fs-1 me-3"></i>

                        <div>

                            <h5 class="card-title mb-1">
                                Ventas
                            </h5>

                            <p class="text-muted mb-0">
                                Registrar y consultar ventas
                            </p>

                        </div>

                    </div>

                    <a asp-controller="Ventas"
                       asp-action="Index"
                       class="btn btn-dark">

                        Ver ventas

                    </a>

                </div>

            </div>

        </div>


        <!-- CAJAS -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">

                        <i class="bi bi-cash-stack fs-1 me-3"></i>

                        <div>

                            <h5 class="card-title mb-1">
                                Cajas
                            </h5>

                            <p class="text-muted mb-0">
                                Control de caja
                            </p>

                        </div>

                    </div>

                    <a asp-controller="Cajas"
                       asp-action="Index"
                       class="btn btn-dark">

                        Ver cajas

                    </a>

                </div>

            </div>

        </div>


        <!-- REPORTES -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">

                        <i class="bi bi-bar-chart-fill fs-1 me-3"></i>

                        <div>

                            <h5 class="card-title mb-1">
                                Reportes
                            </h5>

                            <p class="text-muted mb-0">
                                Consultar reportes del sistema
                            </p>

                        </div>

                    </div>

                    <a asp-controller="Reportes"
                       asp-action="Index"
                       class="btn btn-dark">

                        Ver reportes

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>